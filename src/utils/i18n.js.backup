    run_guide_understood:"Entendido",
    run_disclaimer_title:"Aviso",
    run_disclaimer_text:"StillMind no es una app médica y no reemplaza el diagnóstico o tratamiento de médicos o terapeutas.",
    run_breath_session_desc:"Ejercicio de respiración de 60 segundos – guiado por el círculo pulsante.",
    share_quote_fallback:"Un momento solo para ti.",
    run_breath_label_inhale:"Inhalar",
    run_breath_label_exhale:"Exhalar",
    run_session_auto:"Luego la sesión comienza automáticamente.",
    bib_breath_diaphragmatic_title:"Respiración diafragmática",
    bib_breath_diaphragmatic_tag:"Terapéutica · Medicina del estrés",
    bib_breath_diaphragmatic_why:"Técnica estándar en psicoterapia y medicina del estrés: calma rápidamente y hace la respiración controlable.",
    bib_breath_box_tag:"Tactical Breathing",
    bib_breath_box_why:"Técnica militar para control emocional y concentración.",
    bib_breath_coherent_title:"Respiración coherente",
    bib_breath_coherent_tag:"HRV · Respiración de resonancia",
    bib_breath_coherent_why:"Ritmo constante (HRV): estabiliza y tranquiliza.",
    bib_breath_long_exhale_title:"Exhalación extendida",
    bib_breath_long_exhale_tag:"Terapia conductual",
    bib_breath_long_exhale_why:"La exhalación larga señala seguridad: reduce estrés y tensión.",
    bib_breath_phys_sigh_title:"Suspiro fisiológico",
    bib_breath_phys_sigh_tag:"Stanford / Huberman",
    bib_breath_phys_sigh_why:"Calma muy rápida: ideal para estrés agudo (sin contener la respiración).",
    bib_breath_nostril_title:"Respiración alternada",
    bib_breath_nostril_tag:"Nadi Shodhana",
    bib_breath_nostril_why:"Alternancia calmada y constante: puede apoyar la concentración y el equilibrio interior.",
    bib_breath_pursed_title:"Respiración con labios fruncidos",
    bib_breath_pursed_tag:"Neumología",
    bib_breath_pursed_why:"Ralentiza el flujo respiratorio: ayuda a bajar el ritmo.",
    bib_breath_counting_title:"Conteo respiratorio",
    bib_breath_counting_tag:"Terapia basada en mindfulness",
    bib_breath_counting_why:"Aleja la mente de los bucles de pensamientos: aporta estructura.",
    bib_breath_observe_title:"Observación respiratoria",
    bib_breath_observe_tag:"MBSR (Kabat-Zinn)",
    bib_breath_observe_why:"No fuerces nada, solo observa. Especialmente bueno cuando te estás exigiendo demasiado.",
    bib_prog_sleep_title:"Ritual Nocturno",
    bib_prog_sleep_tag:"Rutina nocturna · diaria · 60 seg.",
    bib_prog_sleep_why:"Ideal cuando tu mente no se desconecta. Breve, calmado, repetible: hasta que se vuelva un hábito.",
    bib_prog_workday_title:"Reset del Día Laboral",
    bib_prog_workday_tag:"Entre reuniones · 60 seg.",
    bib_prog_workday_why:"Para días con reuniones, presión y muy poco espacio para respirar. 60 segundos suelen ser suficientes.",
    bib_prog_morning_title:"Ritual Matutino",
    bib_prog_morning_tag:"Mañanas · 5 días · 60 seg.",
    bib_prog_morning_why:"Comienza el día con la mente clara antes de desbloquear el primer dispositivo.",
    bib_prog_emotion_title:"Mantente emocionalmente estable",
    bib_prog_emotion_tag:"Programa · 3 días · Emociones",
    bib_prog_emotion_why:"Cuando las emociones se intensifican: este curso te ayuda a responder en lugar de reaccionar.",
    bib_prog_focus_title:"Semana de concentración",
    bib_prog_focus_tag:"Programa · 5 días · Trabajo profundo",
    bib_prog_focus_why:"Concentración más aguda sin fuerza de voluntad. 60 segundos diarios que marcan la diferencia.",
    bib_know_stressloop_title:"El estrés es un ciclo",
    bib_know_stressloop_tag:"Conocimiento · Vida diaria",
    bib_know_stressloop_body:"El estrés a menudo se siente como 'demasiado en la cabeza', pero es un estado corporal. Cuando reduces brevemente la activación (respiración, tono muscular, atención), tu pensamiento automáticamente se vuelve más claro.",
    bib_know_panic_title:"Agudo: Qué hacer cuando te sientes abrumado",
    bib_know_panic_tag:"Conocimiento · Ayuda inmediata",
    bib_know_panic_body:"Cuando se vuelve agudo, evita contener la respiración por mucho tiempo. Elige una exhalación calmada y extendida. El objetivo no es la perfección, sino una pequeña señal de 'estoy seguro'. Reflexiona después.",
    bib_know_habit_title:"Mini hábito en lugar de disciplina",
    bib_know_habit_tag:"Conocimiento · Motivación",
    bib_know_vagus_title:"El nervio vago y tú",
    bib_know_vagus_tag:"Conocimiento · Cuerpo",
    bib_know_vagus_body:"El nervio vago conecta el cerebro y el intestino: es la autopista de información del sistema parasimpático. Exhalar lentamente, tararear o agua fría en la cara lo estimulan directamente. Por eso los ejercicios de respiración funcionan tan rápido.",
    bib_know_cortisol_title:"Entender el cortisol",
    bib_know_cortisol_tag:"Conocimiento · Hormonas del estrés",
    bib_know_cortisol_body:"El cortisol no es el enemigo: te mantiene en marcha. Se vuelve problemático cuando los niveles permanecen elevados a largo plazo. Las mini-pausas regulares reducen el nivel base durante semanas. Eso es medible.",
    bib_know_breathscience_title:"La ciencia de la respiración",
    bib_know_breathscience_tag:"Conocimiento · Investigación",
    bib_know_breathscience_body:"Los estudios demuestran: solo 5 respiraciones lentas aumentan la variabilidad de la frecuencia cardíaca (HRV). La exhalación extendida (4 dentro, 6 fuera) activa directamente el nervio vago y reduce la frecuencia cardíaca en segundos.",
    bib_know_sleep_title:"Por qué no puedes dormirte",
    bib_know_sleep_tag:"Conocimiento · Sueño",
    bib_know_sleep_body:"El cerebro necesita una 'señal de seguridad' para dormirse. Los pensamientos y la luz de pantalla bloquean esta señal. Un ejercicio corto de respiración envía deliberadamente: 'Ahora está tranquilo.' — el cerebro sigue.",
    bib_know_hrv_title:"HRV — tu medidor de estrés",
    bib_know_hrv_tag:"Conocimiento · Medición",
    bib_know_hrv_body:"La variabilidad de la frecuencia cardíaca (HRV) muestra qué tan flexiblemente responde tu sistema nervioso a los estímulos. Un valor alto significa: estás recuperado y resistente. Respirar regularmente aumenta el HRV — medible después de unas semanas.",
    bib_free_sub:"Ver gratis · Mejora para acceder",
    bib_prog_not_started:"Aún no iniciado",
