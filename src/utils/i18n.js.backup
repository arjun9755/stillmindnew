    bib_prog_focus_tag:"Program · 5 days · Deep Work",
    bib_prog_focus_why:"Sharper concentration without willpower. 60 seconds daily that make the difference.",
    bib_prog_focus_step1:"Day 1: Set focus trigger",
    bib_prog_focus_step2:"Day 2: Mentally push away distractions",
