    run_session_auto:"Daarna start de sessie automatisch.",
    bib_breath_diaphragmatic_title:"Buikademhaling",
    bib_breath_diaphragmatic_tag:"Therapeutisch · Stressgeneeskunde",
    bib_breath_diaphragmatic_why:"Standaardtechniek in psychotherapie & stressgeneeskunde – kalmeert snel en maakt ademhaling controleerbaar.",
    bib_breath_box_tag:"Tactical Breathing",
    bib_breath_box_why:"Militaire techniek voor emotionele controle & focus.",
    bib_breath_coherent_title:"Coherente ademhaling",
    bib_breath_coherent_tag:"HRV · Resonantieademhaling",
    bib_breath_coherent_why:"Stabiel ritme (HRV) – stabiliserend en aardemd.",
    bib_breath_long_exhale_title:"Verlengde uitademing",
    bib_breath_long_exhale_tag:"Gedragstherapie",
    bib_breath_long_exhale_why:"Lange uitademing geeft veiligheidssignaal – vermindert stress & spanning.",
    bib_breath_phys_sigh_title:"Fysiologische zucht",
    bib_breath_phys_sigh_tag:"Stanford / Huberman",
    bib_breath_phys_sigh_why:"Zeer snelle kalmering – ideaal bij acute stress (zonder ademhouden).",
    bib_breath_nostril_title:"Wisselende neusgat",
    bib_breath_nostril_tag:"Nadi Shodhana",
    bib_breath_nostril_why:"Rustige, gelijkmatige wisseling – kan focus en innerlijke balans ondersteunen.",
    bib_breath_pursed_title:"Ademhaling met getuite lippen",
    bib_breath_pursed_tag:"Longziekten",
    bib_breath_pursed_why:"Vertraagt de ademstroom – helpt het tempo omlaag te brengen.",
    bib_breath_counting_title:"Adem tellen",
    bib_breath_counting_tag:"Mindfulness-gebaseerde therapie",
    bib_breath_counting_why:"Trekt je hoofd weg van gedachtenkringen – brengt structuur.",
    bib_breath_observe_title:"Adem observeren",
    bib_breath_observe_tag:"MBSR (Kabat-Zinn)",
    bib_breath_observe_why:"Niets forceren – alleen waarnemen. Vooral goed als je te veel doet.",
    bib_prog_sleep_title:"Avondritueel",
    bib_prog_sleep_tag:"Avondroutine · dagelijks · 60 sec.",
    bib_prog_sleep_why:"Ideaal als je hoofd niet uitschakelt. Kort, rustig, herhaalbaar – totdat het een gewoonte wordt.",
    bib_prog_workday_title:"Werkdag Reset",
    bib_prog_workday_tag:"Tussen meetings · 60 sec.",
    bib_prog_workday_why:"Voor dagen met meetings, druk en te weinig ademruimte. 60 seconden is vaak genoeg.",
    bib_prog_morning_title:"Ochtend Ritueel",
    bib_prog_morning_tag:"Ochtends · 5 dagen · 60 sec.",
    bib_prog_morning_why:"De dag beginnen met een heldere geest voordat het eerste apparaat wordt ontgrendeld.",
    bib_prog_emotion_title:"Emotioneel stabiel blijven",
    bib_prog_emotion_tag:"Programma · 3 dagen · Emoties",
    bib_prog_emotion_why:"Als emoties hoog oplopen – deze cursus helpt je niet te reageren, maar te beslissen.",
    bib_prog_focus_title:"Focus week",
    bib_prog_focus_tag:"Programma · 5 dagen · Deep Work",
    bib_prog_focus_why:"Scherpere concentratie zonder wilskracht. Dagelijks 60 seconden die het verschil maken.",
    bib_know_stressloop_title:"Stress is een cyclus",
    bib_know_stressloop_tag:"Kennis · Dagelijks leven",
    bib_know_stressloop_body:"Stress voelt vaak als 'te veel in je hoofd' – maar het is een lichamelijke staat. Als je even naar beneden reguleert (ademhaling, spierspanning, aandacht), wordt je denken automatisch helderder.",
    bib_know_panic_title:"Acuut: Wat doen bij overbelasting",
    bib_know_panic_tag:"Kennis · Eerste hulp",
    bib_know_panic_body:"Als het acuut wordt, vermijd lang ademhouden. Kies een rustige, verlengde uitademing. Het doel is niet perfectie, maar een klein 'ik ben veilig'-signaal. Daarna pas reflecteren.",
    bib_know_habit_title:"Mini-gewoonte in plaats van discipline",
    bib_know_habit_tag:"Kennis · Motivatie",
    bib_know_vagus_title:"De nervus vagus en jij",
    bib_know_vagus_tag:"Kennis · Lichaam",
    bib_know_vagus_body:"De nervus vagus verbindt hersenen en darmen – het is de snelweg van het parasympathische systeem. Langzaam uitademen, neuriën, of koud water op je gezicht stimuleren hem direct. Daarom werken ademhalingsoefeningen zo snel.",
    bib_know_cortisol_title:"Cortisol begrijpen",
    bib_know_cortisol_tag:"Kennis · Stresshormonen",
    bib_know_cortisol_body:"Cortisol is niet de vijand – het houdt je gaande. Het wordt problematisch wanneer het niveau langdurig verhoogd blijft. Regelmatige mini-pauzes verlagen het basisniveau over weken. Dat is meetbaar.",
    bib_know_breathscience_title:"De wetenschap van ademhaling",
    bib_know_breathscience_tag:"Kennis · Onderzoek",
    bib_know_breathscience_body:"Studies tonen aan: al 5 langzame ademhalingen verhogen de hartritmevariabiliteit (HRV). Verlengde uitademing (4 in, 6 uit) activeert direct de nervus vagus en verlaagt de hartslag binnen seconden.",
    bib_know_sleep_title:"Waarom je niet kunt inslapen",
    bib_know_sleep_tag:"Kennis · Slaap",
    bib_know_sleep_body:"De hersenen hebben een 'veiligheidssignaal' nodig om in te slapen. Gedachten en schermverlichting blokkeren dit signaal. Een korte ademhalingsoefening stuurt bewust: 'Nu is het rustig.' – de hersenen volgen.",
    bib_know_hrv_title:"HRV – jouw stressmeter",
    bib_know_hrv_tag:"Kennis · Meting",
    bib_know_hrv_body:"Hartritmevariabiliteit (HRV) toont hoe flexibel je zenuwstelsel reageert op prikkels. Een hoge waarde betekent: je bent hersteld en veerkrachtig. Regelmatige ademhaling verhoogt HRV – meetbaar na een paar weken.",
    bib_free_sub:"Gratis bekijken · Upgrade voor toegang",
