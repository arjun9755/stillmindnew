    bib_breath_long_exhale_tag:"Beteendeterapi",
    bib_breath_long_exhale_why:"Lång utandning signalerar trygghet – minskar stress och spänning.",
    bib_breath_phys_sigh_title:"Fysiologisk suck",
    bib_breath_phys_sigh_tag:"Stanford / Huberman",
    bib_breath_phys_sigh_why:"Mycket snabb lugnande effekt – perfekt vid akut stress (utan andhållning).",
    bib_breath_nostril_title:"Växelvis näsandning",
    bib_breath_nostril_tag:"Nadi Shodhana",
    bib_breath_nostril_why:"Lugn, jämn växling – kan stödja fokus och inre balans.",
    bib_breath_pursed_title:"Andning med slutna läppar",
    bib_breath_pursed_tag:"Lungmedicin",
    bib_breath_pursed_why:"Saktar ner andningsflödet – hjälper dig att ta det lugnt.",
    bib_breath_counting_title:"Andningsräkning",
    bib_breath_counting_tag:"Mindfulnessbaserad terapi",
    bib_breath_counting_why:"Leder bort tankarna från tankespiraler – skapar struktur.",
    bib_breath_observe_title:"Andningsobservation",
    bib_breath_observe_tag:"MBSR (Kabat-Zinn)",
    bib_breath_observe_why:"Forcera inget – bara observera. Särskilt bra när du överanstränger dig.",
    bib_prog_sleep_title:"Kvällsritual",
    bib_prog_sleep_tag:"Kvällsrutin · daglig · 60 sek.",
    bib_prog_sleep_why:"Perfekt när dina tankar inte vill slå av. Kort, lugn, repeterbar – tills det blir en vana.",
    bib_prog_workday_title:"Arbetsdagsreset",
    bib_prog_workday_tag:"Mellan möten · 60 sek.",
    bib_prog_workday_why:"För dagar med möten, press och för lite andrum. 60 sekunder räcker ofta.",
    bib_prog_morning_title:"Morgonritual",
    bib_prog_morning_tag:"Morgon · 5 dagar · 60 sek.",
    bib_prog_morning_why:"Börja dagen med klart huvud innan första enheten låses upp.",
    bib_prog_emotion_title:"Håll dig emotionellt stabil",
    bib_prog_emotion_tag:"Program · 3 dagar · Känslor",
    bib_prog_emotion_why:"När känslorna kokar över – denna kurs hjälper dig att svara istället för att reagera.",
    bib_prog_focus_title:"Fokusvecka",
    bib_prog_focus_tag:"Program · 5 dagar · Deep Work",
    bib_prog_focus_why:"Skarpare koncentration utan viljestyrka. 60 sekunder dagligen som gör skillnaden.",
    bib_know_stressloop_title:"Stress är en cykel",
    bib_know_stressloop_tag:"Kunskap · Vardag",
    bib_know_stressloop_body:"Stress känns ofta som 'för mycket i huvudet' – men det är ett kroppsläge. När du kort reglerar ner (andning, muskeltonus, uppmärksamhet) blir ditt tänkande automatiskt klarare.",
    bib_know_panic_title:"Akut: Vad du gör vid överväldigande känslor",
    bib_know_panic_tag:"Kunskap · Akuthjälp",
    bib_know_panic_body:"När det blir akut, undvik långa andhållningar. Välj en lugn, förlängd utandning. Målet är inte perfektion, utan en liten 'jag är trygg'-signal. Reflektera efteråt.",
    bib_know_habit_title:"Minivana istället för disciplin",
    bib_know_habit_tag:"Kunskap · Motivation",
    bib_know_vagus_title:"Vagusnerven och du",
    bib_know_vagus_tag:"Kunskap · Kropp",
    bib_know_vagus_body:"Vagusnerven förbinder hjärna och mage – den är det parasympatiska systemets informationsmotorväg. Långsam utandning, nynning eller kallt vatten i ansiktet stimulerar den direkt. Därför fungerar andningsövningar så snabbt.",
    bib_know_cortisol_title:"Förstå kortisol",
    bib_know_cortisol_tag:"Kunskap · Stresshormoner",
    bib_know_cortisol_body:"Kortisol är inte fienden – det håller dig igång. Det blir problematiskt när nivåerna förblir förhöjda på lång sikt. Regelbundna minipauser sänker grundnivån över veckor. Det är mätbart.",
    bib_know_breathscience_title:"Andningens vetenskap",
    bib_know_breathscience_tag:"Kunskap · Forskning",
    bib_know_breathscience_body:"Studier visar: bara 5 långsamma andetag ökar hjärtrytmvariabiliteten (HRV). Förlängd utandning (4 in, 6 ut) aktiverar vagusnerven direkt och sänker hjärtfrekvensen på sekunder.",
    bib_know_sleep_title:"Varför du inte kan somna",
    bib_know_sleep_tag:"Kunskap · Sömn",
    bib_know_sleep_body:"Hjärnan behöver en 'säkerhetssignal' för att somna. Tankar och skärmljus blockerar denna signal. En kort andningsövning skickar medvetet: 'Nu är det lugnt.' – hjärnan följer.",
    bib_know_hrv_title:"HRV – din stressmätare",
    bib_know_hrv_tag:"Kunskap · Mätning",
    bib_know_hrv_body:"Hjärtrytmvariabilitet (HRV) visar hur flexibelt ditt nervsystem reagerar på stimuli. Ett högt värde betyder: du är återhämtad och motståndskraftig. Regelbunden andning ökar HRV – mätbart efter några veckor.",
    bib_free_sub:"Visa gratis · Uppgradera för åtkomst",
