    run_breath_coherent_title:"Respiración coherente",
    run_breath_coherent_semantic:"Estabilidad y equilibrio",
    run_breath_coherent_why:"Respiración de resonancia (HRV) para un ritmo tranquilo y constante.",
    run_breath_coherent_guidance:"Uniforme — como si contaras un compás tranquilo.",
    run_breath_long_exhale_title:"Exhalación extendida",
    run_breath_long_exhale_semantic:"Reduce estrés",
    run_breath_long_exhale_why:"La exhalación larga señala seguridad y reduce la tensión.",
    run_breath_long_exhale_guidance:"Exhala más largo que la inhalación — eso señala seguridad.",
    run_breath_phys_sigh_title:"Suspiro fisiológico",
    run_breath_phys_sigh_subtitle:"inhala profundo · continúa corto · exhala largo",
    run_breath_phys_sigh_semantic:"Reset agudo",
    run_breath_phys_sigh_why:"Alivio rápido cuando te aceleras.",
    run_breath_phys_sigh_guidance:"Cuando te estresas agudamente: 1 inhalación profunda, 1 continuación corta, luego exhala largo.",
    run_breath_nostril_title:"Respiración alterna",
    run_breath_nostril_subtitle:"izquierda/derecha sin retener",
    run_breath_nostril_semantic:"Equilibrio y concentración",
    run_breath_nostril_why:"Alternancia suave para aclarar la mente y fortalecer la presencia.",
    run_breath_nostril_guidance:"Sin retener el aire. Alterna con calma.",
    run_breath_pursed_title:"Respiración con labios fruncidos",
    run_breath_pursed_semantic:"Control respiratorio",
    run_breath_pursed_why:"Ralentiza el flujo de aire y calma el ritmo.",
    run_breath_pursed_guidance:"Inhala por la nariz – exhala lentamente por labios fruncidos.",
    run_breath_counting_title:"Conteo respiratorio",
    run_breath_counting_semantic:"Claridad mental",
    run_breath_counting_why:"Contar da estructura y te saca del carrusel de pensamientos.",
    run_breath_counting_guidance:"Cuenta en silencio: Inhalar (1) – Exhalar (2) … hasta 10.",
    run_breath_observe_title:"Observación respiratoria",
    run_breath_observe_subtitle:"sin cambiar nada",
    run_breath_observe_semantic:"Mindfulness y claridad",
    run_breath_observe_why:"No cambies nada, solo observa. Perfecto cuando te exiges demasiado.",
    run_breath_observe_guidance:"Solo observa. Si surgen pensamientos: nótalos, regresa a la respiración.",
    run_breath_sleep_title:"Modo dormir",
    run_breath_sleep_semantic:"Soltar y dormir",
    run_breath_sleep_why:"Premium Life – exclusivo. Sesión extendida a 20 min. El ritmo respiratorio se ralentiza automáticamente.",
    bib_sleep_hero_tag:"Premium Life · 20 min · exclusivo",
    bib_sleep_hero_teaser:"Tu respiración se ralentiza automáticamente – de 4 segundos hasta suaves 8 segundos. Perfecto justo antes de dormir.",
