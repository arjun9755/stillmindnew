<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Stone -->
    <TextView
        android:id="@+id/widget_stone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="🪨"
        android:textSize="38sp"
        android:gravity="center"
        android:layout_marginEnd="14dp" />

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Streak badge -->
        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#CDB98A"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/badge_background"
            android:layout_marginBottom="5dp"
            android:visibility="gone" />

        <!-- Main message -->
        <TextView
            android:id="@+id/widget_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heute noch nichts."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="2"
            android:layout_marginBottom="4dp" />

        <!-- Sub message -->
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 Sekunden reichen."
            android:textSize="11sp"
            android:textColor="#73FFFFFF"
            android:maxLines="1"
            android:layout_marginBottom="6dp" />

        <!-- CTA -->
        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jetzt starten →"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#CDB98A"
            android:visibility="visible" />

    </LinearLayout>

</LinearLayout>
