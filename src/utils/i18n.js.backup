    monthly_sub:"המבט שלך על החודש.",
    pro:"Pro",
    premium_life:"Premium Life"
  },
};

let _currentLang = "de";
let _listeners = [];

export const initI18n = async () => {
  try {
    const stored = await AsyncStorage.getItem(LANG_KEY);
    if (stored && translations[stored]) _currentLang = stored;
  } catch (_) {}
};

export const getLanguage = () => _currentLang;

export const setLanguage = async (lang) => {
  if (!translations[lang]) return;
  _currentLang = lang;
  await AsyncStorage.setItem(LANG_KEY, lang).catch(() => {});
  _listeners.forEach((fn) => fn(lang));
};

export const addLanguageListener = (fn) => {
  _listeners.push(fn);
  return () => { _listeners = _listeners.filter((l) => l !== fn); };
};

export const t = (key, vars = {}) => {
  const dict = translations[_currentLang] || translations["de"];
  const val = dict[key] != null ? dict[key] : translations["de"][key];
  let str = val != null ? val : key;
  Object.entries(vars).forEach(([k, v]) => {
    str = str.replace(new RegExp(`\\{\\{${k}\\}\\}`, "g"), String(v));
  });
  return str;
};

export const useI18n = () => {
  const { useState, useEffect, useCallback } = require("react");
  const [lang, setLang] = useState(_currentLang);
  useEffect(() => addLanguageListener((l) => setLang(l)), []);
  const translate = useCallback((key, vars = {}) => t(key, vars), [lang]); // eslint-disable-line react-hooks/exhaustive-deps
  return { t: translate, lang };
};

export const SUPPORTED_LANGUAGES = [
  { code: "de", label: "Deutsch", flag: "🇩🇪" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "zh", label: "中文", flag: "🇨🇳" },
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "pt", label: "Português", flag: "🇧🇷" },
  { code: "ja", label: "日本語", flag: "🇯🇵" },
  { code: "ko", label: "한국어", flag: "🇰🇷" },
  { code: "it", label: "Italiano", flag: "🇮🇹" },
  { code: "ru", label: "Русский", flag: "🇷🇺" },
  { code: "hi", label: "हिन्दी", flag: "🇮🇳" },
  { code: "tr", label: "Türkçe", flag: "🇹🇷" },
  { code: "nl", label: "Nederlands", flag: "🇳🇱" },
  { code: "pl", label: "Polski", flag: "🇵🇱" },
  { code: "sv", label: "Svenska", flag: "🇸🇪" },
  { code: "he", label: "עברית", flag: "🇮🇱" },
];

export default { t, getLanguage, setLanguage, initI18n, useI18n, SUPPORTED_LANGUAGES };
