    // Mode labels (used in mode-quotes.js)
    // Session quotes - calm
    quote_calm_0:"Ruhe ist nicht die Abwesenheit von Sturm, sondern Frieden mitten im Sturm.",
    quote_calm_1:"In der Stille findest du die Kraft, die der Lärm dir nimmt.",
    quote_calm_2:"Atmen ist der Anker, der dich im Hier und Jetzt hält.",
    quote_calm_3:"Jeder Moment der Ruhe ist ein Geschenk an dich selbst.",
    quote_calm_4:"Nicht alles braucht sofort eine Lösung. Manchmal reicht es, einfach zu sein.",
    quote_calm_5:"Die Welt kann warten. Diese Minute gehört dir.",
    // sleep
    quote_sleep_0:"Jeder Atemzug bringt dich näher zur Ruhe, die du verdienst.",
    quote_sleep_1:"Der Tag ist vorbei. Du darfst loslassen.",
    quote_sleep_2:"Schlaf ist kein Luxus, sondern dein natürliches Recht.",
    quote_sleep_3:"Mit jedem Ausatmen sinkt die Last des Tages von deinen Schultern.",
    quote_sleep_4:"Die Nacht ist deine Verbündete. Vertraue ihr.",
    quote_sleep_5:"Dein Körper weiß, was er braucht. Gib ihm die Ruhe.",
    // focus
    quote_focus_0:"Klarheit entsteht, wenn du einen Moment innehältst.",
    quote_focus_1:"Konzentration ist kein Zwang, sondern eine bewusste Wahl.",
    quote_focus_2:"Eine ruhige Minute schafft Raum für klare Gedanken.",
    quote_focus_3:"Du musst nicht perfekt sein, um produktiv zu sein.",
    quote_focus_4:"Fokus bedeutet nicht Härte, sondern Präsenz.",
    quote_focus_5:"Kleine Pausen machen große Ergebnisse möglich.",
    // emotion
    quote_emotion_0:"Deine Gefühle sind wertvoll. Du darfst dir Zeit geben.",
    quote_emotion_1:"Es ist okay, nicht okay zu sein.",
    quote_emotion_2:"Gefühle sind wie Wellen – sie kommen und gehen.",
    quote_emotion_3:"Du musst nicht alles sofort verstehen. Fühl einfach.",
    quote_emotion_4:"Deine Emotionen machen dich menschlich, nicht schwach.",
    quote_emotion_5:"Manchmal ist Fühlen der erste Schritt zur Heilung.",
    // parent
    quote_parent_0:"Du gibst dein Bestes. Das ist genug.",
    quote_parent_1:"Auch Eltern brauchen Pausen. Du darfst eine nehmen.",
    quote_parent_2:"Perfekt gibt es nicht. Aber liebevoll – das schaffst du.",
    quote_parent_3:"Deine Energie ist wertvoll. Schütze sie.",
    quote_parent_4:"Es ist okay, nicht alle Antworten zu haben.",
    quote_parent_5:"Du bist mehr als deine Rolle. Du bist auch Mensch.",
    // work
    quote_work_0:"Diese Minute gehört dir. Niemand sonst.",
    quote_work_1:"Pausen sind keine Zeitverschwendung, sondern Investitionen in dich.",
    quote_work_2:"Du musst nicht immer 'on' sein.",
    quote_work_3:"Auch kleine Momente der Ruhe machen einen Unterschied.",
    quote_work_4:"Deine Arbeit läuft nicht weg. Aber deine Energie schon.",
    quote_work_5:"Einatmen. Ausatmen. Weitermachen. In dieser Reihenfolge.",
    // thoughts
    quote_thoughts_0:"Gedanken sind wie Wolken – lass sie kommen und gehen.",
    quote_thoughts_1:"Du musst nicht jeden Gedanken zu Ende denken.",
    quote_thoughts_2:"Grübeln ist wie Schaukeln – viel Bewegung, aber du kommst nicht weiter.",
    quote_thoughts_3:"Manchmal ist Stopp sagen das Mutigste, was du tun kannst.",
    quote_thoughts_4:"Dein Kopf darf Pause machen. Nicht alles muss jetzt gelöst werden.",
    quote_thoughts_5:"Ein klarer Kopf braucht manchmal einfach nur: Nichts.",
