{
  "expo": {
    "name": "StillMind",
    "slug": "mobile",
    "scheme": "stillmind",
    "owner": "dennis19991808",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0B"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#CDB98A",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": false,
          "androidRecordAudioPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "CA92.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "C617.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "35F9.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "E174.1"
                  ]
                }
              ],
              "NSPrivacyCollectedDataTypes": [],
              "NSPrivacyTracking": false,
              "NSPrivacyTrackingDomains": []
            }
          },
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "StillMind speichert Share Cards in deiner Galerie.",
          "savePhotosPermission": "StillMind speichert Share Cards in deiner Galerie.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./modules/stillmind-widget/plugin",
      [
        "react-native-health",
        {
          "healthSharePermission": "StillMind speichert deine Meditationssitzungen in der Health-App.",
          "healthUpdatePermission": "StillMind speichert deine Meditationssitzungen in der Health-App."
        }
      ],
      "react-native-health-connect"
    ],
    "ios": {
      "bundleIdentifier": "de.stillmind.app",
      "buildNumber": "90",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "de",
          "en",
          "es",
          "zh",
          "fr",
          "pt",
          "ja",
          "ko",
          "it",
          "ru",
          "hi",
          "tr",
          "nl",
          "pl",
          "sv",
          "he"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "NSUserNotificationsUsageDescription": "StillMind sendet dir sanfte Erinnerungen für deine tägliche Achtsamkeitspraxis.",
        "NSHealthShareUsageDescription": "StillMind schreibt deine Achtsamkeitsminuten in Apple Health.",
        "NSHealthUpdateUsageDescription": "StillMind schreibt deine Achtsamkeitsminuten in Apple Health.",
        "NSPhotoLibraryAddUsageDescription": "StillMind speichert deine Share Cards in der Fotogalerie."
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": [
          "group.de.stillmind.app"
        ]
      },
      "deploymentTarget": "16.0"
    },
    "android": {
      "package": "de.stillmind.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 5,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "stillmind"
            },
            {
              "scheme": "https",
              "host": "appstillmind.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "db6578f4-6cd7-4acb-a2c2-f08115ac00dc"
      }
    },
    "version": "1.2.3",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/db6578f4-6cd7-4acb-a2c2-f08115ac00dc",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
