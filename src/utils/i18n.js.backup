    bib_breath_coherent_title:"Oddech koherentny",
    bib_breath_coherent_tag:"HRV · Oddech rezonansowy",
    bib_breath_coherent_why:"Równy rytm (HRV) – stabilizuje i uziemia.",
    bib_breath_long_exhale_title:"Wydłużony wydech",
    bib_breath_long_exhale_tag:"Terapia behawioralna",
    bib_breath_long_exhale_why:"Długi wydech sygnalizuje bezpieczeństwo – redukuje stres i napięcie.",
    bib_breath_phys_sigh_title:"Westchnienie fizjologiczne",
    bib_breath_phys_sigh_tag:"Stanford / Huberman",
    bib_breath_phys_sigh_why:"Bardzo szybkie uspokojenie – idealne przy ostrym stresie (bez wstrzymywania oddechu).",
    bib_breath_nostril_title:"Naprzemienne nozdrza",
    bib_breath_nostril_tag:"Nadi Shodhana",
    bib_breath_nostril_why:"Spokojna, równa alternacja – może wspierać skupienie i wewnętrzną równowagę.",
    bib_breath_pursed_title:"Oddech przez ściśnięte usta",
    bib_breath_pursed_tag:"Pulmonologia",
    bib_breath_pursed_why:"Spowalnia przepływ oddechu – pomaga zwolnić tempo.",
    bib_breath_counting_title:"Liczenie oddechów",
    bib_breath_counting_tag:"Terapia oparta na uważności",
    bib_breath_counting_why:"Odciąga umysł od pętli myślowych – wprowadza strukturę.",
    bib_breath_observe_title:"Obserwacja oddechu",
    bib_breath_observe_tag:"MBSR (Kabat-Zinn)",
    bib_breath_observe_why:"Nie wymuszaj nic – tylko obserwuj. Szczególnie dobre, gdy się przemęczasz.",
    bib_prog_sleep_title:"Rytuał wieczorny",
    bib_prog_sleep_tag:"Rutyna wieczorna · codziennie · 60 sek.",
    bib_prog_sleep_why:"Idealne, gdy umysł nie chce się wyłączyć. Krótkie, spokojne, powtarzalne – aż stanie się nawykiem.",
    bib_prog_workday_title:"Reset dnia pracy",
    bib_prog_workday_tag:"Między spotkaniami · 60 sek.",
    bib_prog_workday_why:"Na dni ze spotkaniami, presją i za małą ilością czasu na oddech. 60 sekund często wystarcza.",
    bib_prog_morning_title:"Rytuał poranny",
    bib_prog_morning_tag:"Rano · 5 dni · 60 sek.",
    bib_prog_morning_why:"Zacznij dzień z czystą głową, zanim odblokujesz pierwsze urządzenie.",
    bib_prog_emotion_title:"Zostań stabilny emocjonalnie",
    bib_prog_emotion_tag:"Program · 3 dni · Emocje",
    bib_prog_emotion_why:"Gdy emocje biorą górę – ten kurs pomoże ci odpowiadać zamiast reagować.",
    bib_prog_focus_title:"Tydzień skupienia",
    bib_prog_focus_tag:"Program · 5 dni · Deep Work",
    bib_prog_focus_why:"Ostrzejsze skupienie bez siły woli. 60 sekund dziennie, które robią różnicę.",
    bib_know_stressloop_title:"Stres to cykl",
    bib_know_stressloop_tag:"Wiedza · Codzienność",
    bib_know_stressloop_body:"Stres często czuć jak 'za dużo w głowie' – ale to stan ciała. Gdy na chwilę się wyciszysz (oddech, napięcie mięśni, uwaga), myślenie automatycznie staje się jaśniejsze.",
    bib_know_panic_title:"Ostry stan: Co robić przy przytłoczeniu",
    bib_know_panic_tag:"Wiedza · Pomoc doraźna",
    bib_know_panic_body:"W ostrych stanach unikaj długiego wstrzymywania oddechu. Wybierz spokojny, wydłużony wydech. Celem nie jest perfekcja, ale mały sygnał 'jestem bezpieczny'. Refleksja dopiero później.",
    bib_know_habit_title:"Mini-nawyk zamiast dyscypliny",
    bib_know_habit_tag:"Wiedza · Motywacja",
    bib_know_vagus_title:"Nerw błędny i ty",
    bib_know_vagus_tag:"Wiedza · Ciało",
    bib_know_vagus_body:"Nerw błędny łączy mózg z jelitami – to autostrada informacyjna układu parasympatycznego. Powolne wydychanie, nucenie czy zimna woda na twarzy stymulują go bezpośrednio. Dlatego ćwiczenia oddechowe działają tak szybko.",
    bib_know_cortisol_title:"Zrozumieć kortyzol",
    bib_know_cortisol_tag:"Wiedza · Hormony stresu",
    bib_know_cortisol_body:"Kortyzol to nie wróg – to on cię napędza. Problematyczny staje się, gdy poziom długo pozostaje podwyższony. Regularne mini-przerwy obniżają poziom bazowy przez tygodnie. To jest mierzalne.",
    bib_know_breathscience_title:"Nauka o oddychaniu",
    bib_know_breathscience_tag:"Wiedza · Badania",
    bib_know_breathscience_body:"Badania pokazują: już 5 powolnych oddechów zwiększa zmienność rytmu serca (HRV). Wydłużony wydech (4 wdech, 6 wydech) bezpośrednio aktywuje nerw błędny i obniża tętno w ciągu sekund.",
    bib_know_sleep_title:"Dlaczego nie możesz zasnąć",
    bib_know_sleep_tag:"Wiedza · Sen",
    bib_know_sleep_body:"Mózg potrzebuje 'sygnału bezpieczeństwa', żeby zasnąć. Myśli i światło ekranu blokują ten sygnał. Krótkie ćwiczenie oddechowe celowo wysyła: 'Teraz jest spokojnie.' – mózg podąża za tym.",
    bib_know_hrv_title:"HRV – twój miernik stresu",
    bib_know_hrv_tag:"Wiedza · Pomiary",
    bib_know_hrv_body:"Zmienność rytmu serca (HRV) pokazuje, jak elastycznie twój układ nerwowy reaguje na bodźce. Wysoka wartość oznacza: jesteś zregenerowany i odporny. Regularne oddychanie zwiększa HRV – mierzalne po kilku tygodniach.",
    bib_free_sub:"Zobacz za darmo · Upgrade dla dostępu",
